{
  "name": "anonymous-story-viewer-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:extension": "pnpm --filter anonymous-story-viewer build",
    "build:web": "pnpm --filter web build",
    "build:firefox": "pnpm --filter anonymous-story-viewer build:firefox",
    "dev": "pnpm --filter anonymous-story-viewer dev",
    "dev:firefox": "pnpm --filter anonymous-story-viewer dev:firefox",
    "dev:web": "pnpm --filter web dev",
    "compile": "pnpm --filter anonymous-story-viewer compile",
    "zip": "pnpm --filter anonymous-story-viewer zip",
    "zip:firefox": "pnpm --filter anonymous-story-viewer zip:firefox",
    "generate:logo": "pnpm --filter anonymous-story-viewer generate:logo",
    "generate:disabled-icons": "pnpm --filter anonymous-story-viewer generate:disabled-icons",
    "generate:store-assets": "pnpm --filter anonymous-story-viewer generate:store-assets",
    "submit": "pnpm --filter anonymous-story-viewer submit",
    "submit:chrome": "pnpm --filter anonymous-story-viewer submit:chrome",
    "submit:edge": "pnpm --filter anonymous-story-viewer submit:edge",
    "submit:firefox": "pnpm --filter anonymous-story-viewer submit:firefox",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}